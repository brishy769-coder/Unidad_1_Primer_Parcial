CODIFICACION EN JAVA Y C++  

JAVA 

public class Intercambio_variables { 

     

 public static void main(String[] args) { 

    int A = 8, B = 12; 

    int temp; 

    temp = A; 

    A = B ; 

    B = temp; 

    System.out.println("A: " + A); 

    System.out.println("B: " + B); 

        } 

} 

 

 

C++ 

 

#include <iostream> 

using namespace std; 

  

int main() { 

    int A = 8, B = 12; 

    int temp; 

  

    // Intercambio de valores 

    temp = A; 

    A = B; 

    B = temp; 

  

    cout << "A: " << A << endl; 

    cout << "B: " << B << endl; 

  

    return 0; 

} 


 
